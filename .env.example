# В деве backend и web-client живут на разных портах, Vite-прокси не
# используется, поэтому нужен полный базовый URL. В проде (за Caddy)
# оставить пустым - обе части сайта на одном origin, апи ходит по
# относительным путям.
VITE_API_BASE_URL=http://localhost:3001

# То же самое, но для WS-шлюза (см. backend/src/services/WsGatewayService.ts).
# В проде за Caddy можно оставить пустым - соберётся из location текущей страницы.
VITE_WS_URL=ws://localhost:3001/ws
